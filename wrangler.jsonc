{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "text-to-email",
	"main": "src/index.js",
	"compatibility_date": "2025-12-05",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "NUMBER_TO_EMAIL",
